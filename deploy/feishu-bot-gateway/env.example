# Feishu/Lark app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=xxx
# Optional but recommended for strict group @ filtering.
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=MMBAI

# HTTP server
PORT=8096
PUBLIC_BASE_URL=https://your-domain.example.com

# Dify service API
DIFY_BASE_URL=http://nginx/v1
DIFY_ADVISOR_APP_API_KEY=app-xxx
# Optional. If unset, copywriting reuses DIFY_ADVISOR_APP_API_KEY with a copywriting instruction prefix.
DIFY_COPYWRITING_APP_API_KEY=

# Existing poster service
POSTER_SERVICE_URL=http://poster-service:8088
POSTER_POLL_INTERVAL_MS=15000
POSTER_POLL_TIMEOUT_MS=900000
POSTER_SIZE=1080x1440

# Runtime controls
IDEMPOTENCY_TTL_MS=600000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=12
LOG_LEVEL=info
