# HTTP server
PORT=8096
PUBLIC_BASE_URL=https://your-domain.example.com

# Dify service APIs. Per-Bot Feishu secrets and Dify app bindings are configured in Dify workspace settings -> 渠道接入.
DIFY_BASE_URL=http://nginx/v1
DIFY_CONSOLE_API_BASE_URL=http://nginx/console/api

# Existing poster service
POSTER_SERVICE_URL=http://poster-service:8088
POSTER_POLL_INTERVAL_MS=15000
POSTER_POLL_TIMEOUT_MS=900000
POSTER_SIZE=1080x1440

# Runtime controls
IDEMPOTENCY_TTL_MS=600000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=12
RUNTIME_CONFIG_CACHE_TTL_MS=30000
LOG_LEVEL=info
