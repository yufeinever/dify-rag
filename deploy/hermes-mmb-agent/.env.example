HERMES_IMAGE=mmbai/hermes-agent:local
HERMES_REPO_URL=https://github.com/NousResearch/hermes-agent.git
HERMES_REPO_REF=main
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Public ports for the first-stage validation stack.
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
OPEN_WEBUI_PORT=3008

# GPT-5.5 / OpenAI-compatible endpoint used by Hermes.
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
HERMES_DEFAULT_MODEL=gpt-5.5

# MMB Capability Center MCP endpoint.
CAPABILITY_AUTH_TOKEN=
CAPABILITY_MCP_URL=http://mmb-capability-center:8097/mcp

# Optional: make Open WebUI logins simple for the internal validation host.
WEBUI_SECRET_KEY=
OPEN_WEBUI_AUTH=false
