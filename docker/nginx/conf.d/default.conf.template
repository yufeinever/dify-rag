# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

limit_req_zone $binary_remote_addr zone=mmb_mcp_per_ip:10m rate=30r/m;

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    location = /mmb-favicon-refresh-20260705.ico {
      proxy_pass http://web:3000/favicon.ico;
      include proxy.conf;
      add_header Cache-Control "public, max-age=86400" always;
    }

    location = /custom-assets/mmb-logo/signin-logo-patch.js {
      proxy_pass http://web:3000;
      include proxy.conf;
      add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location = /custom-assets/mmb-logo/global-brand-patch.js {
      proxy_pass http://web:3000;
      include proxy.conf;
      add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location /console/api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /socket.io/ {
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /files {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /poster-files/files/ {
      alias /var/www/poster-files/;
      add_header Cache-Control "public, max-age=86400" always;
    }

    location /poster-files/ {
      proxy_pass http://150.5.132.104:8088/files/;
      include proxy.conf;
    }

    location /explore {
      proxy_pass http://web:3000;
      include proxy.conf;
      proxy_set_header Accept-Encoding "";
      sub_filter_once off;
      sub_filter_types text/html;
      sub_filter '</body>' '<script defer src="/custom-assets/mmb-logo/global-brand-patch.js?v=20260624-4"></script></body>';
    }

    location /e/ {
      proxy_pass http://plugin_daemon:5002;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location = /signin {
      proxy_pass http://web:3000;
      include proxy.conf;
      proxy_set_header Accept-Encoding "";
      sub_filter_once off;
      sub_filter_types text/html;
      sub_filter '</body>' '<script defer src="/custom-assets/mmb-logo/signin-logo-patch.js?v=20260627-1"></script></body>';
    }

    location / {
    location /mmbai-docs/ {
      proxy_pass http://docs:3000/;
      include proxy.conf;
      proxy_set_header Accept-Encoding "";
      sub_filter_once off;
      sub_filter_types text/html text/css application/javascript;
      sub_filter 'href="/' 'href="/mmbai-docs/';
      sub_filter 'src="/' 'src="/mmbai-docs/';
      sub_filter 'url(/' 'url(/mmbai-docs/';
    }
      proxy_pass http://web:3000;
      include proxy.conf;
      proxy_set_header Accept-Encoding "";
      sub_filter_once off;
      sub_filter_types text/html;
      sub_filter '</body>' '<script defer src="/custom-assets/mmb-logo/global-brand-patch.js?v=20260624-4"></script></body>';
    }

    location /mcp {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location = /mmb-mcp/mcp {
      limit_except POST { deny all; }
      limit_req zone=mmb_mcp_per_ip burst=10 nodelay;
      proxy_pass http://172.19.0.1:18791/mcp;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:18790;
      proxy_set_header Authorization $http_authorization;
      proxy_set_header Mcp-Session-Id $http_mcp_session_id;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
    }

    location /triggers {
      proxy_pass http://api:5001;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
